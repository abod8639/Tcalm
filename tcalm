#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Tcalm - Prayer Time Media Pauser for Linux and macOS.
Entrypoint script that locates tcalm_core and launches the CLI.
"""

import os
import sys

# 1. Look for tcalm_core relative to the actual real path of this file (e.g. repo or symlink target)
real_script_dir = os.path.dirname(os.path.realpath(__file__))
if os.path.isdir(os.path.join(real_script_dir, "tcalm_core")):
    if real_script_dir not in sys.path:
        sys.path.insert(0, real_script_dir)

# 2. Look for installed tcalm_core in user's ~/.local/share/tcalm
shared_dir = os.path.expanduser("~/.local/share/tcalm")
if os.path.isdir(os.path.join(shared_dir, "tcalm_core")):
    if shared_dir not in sys.path:
        sys.path.insert(0, shared_dir)

try:
    from tcalm_core.cli import main
except ImportError as e:
    sys.stderr.write(f"Error: Could not import tcalm_core ({e}).\nPlease reinstall via ./install.sh\n")
    sys.exit(1)

if __name__ == "__main__":
    main()
